APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
# One selector for API, Worker and browser. Restart API AND Worker after changing.
# Configure both profiles once. Do not set the old CHAIN_ID variable.
CHAIN_NETWORK=testnet

# Testnet only: one claim sends exactly 10 kUSDC from PAYMENT_PROVIDER.
# Automatically available when both Turnstile keys and settlement are configured.
# Register PUBLIC_ORIGIN's hostname in this Turnstile widget.
TESTNET_FAUCET_ENABLED=true
TESTNET_TURNSTILE_SITE_KEY=
TESTNET_TURNSTILE_SECRET_KEY=
TESTNET_FAUCET_COOLDOWN_HOURS=24
TESTNET_FAUCET_IP_DAILY_LIMIT=10
TESTNET_FAUCET_DAILY_LIMIT=100
# openssl rand -base64 32. Keep stable: encrypts credentials and signed journals.
APP_SECRET=
ADMIN_WALLETS=
ALLOW_PRIVATE_UPSTREAMS=false
# Optional HTTPS URL for this backend's corresponding source. Production requires an HTTPS PUBLIC_ORIGIN.
SOURCE_URL=
TRUSTED_PROXY_CIDRS=

# Shared login app; optional TESTNET_PRIVY_* / MAINNET_PRIVY_* overrides supported.
# App secret remains on the server; browser obtains only App ID via /api/config.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_GAS_SPONSORSHIP_ENABLED=false
PRIVY_DAILY_SPONSORED_TRANSACTIONS=30
# Enable the selected Monad chain and App pays in Privy's dashboard first.

# MONAD TESTNET (10143) — kUSDC and test Aave pool
TESTNET_DATABASE_URL=postgres://localhost:55432/tokenswoop?sslmode=disable
TESTNET_REDIS_URL=redis://127.0.0.1:6389/0
TESTNET_SETTLEMENT_ENABLED=false
# Private HTTPS RPC only here; never use VITE_* or put it in source.
TESTNET_PAYMENT_RPC_URL=https://testnet-rpc.monad.xyz
# Endpoint quota shared by API, Worker, Reserve and /api/rpc; QuickNode: 40.
TESTNET_PAYMENT_RPC_RPS=5
TESTNET_PAYMENT_CONTRACT=
TESTNET_PAYMENT_TOKEN=
TESTNET_PAYMENT_PROVIDER=
# Leave blank only for the existing provider-as-recipient deployment.
TESTNET_PAYMENT_RECIPIENT=
# Fixed stop address may be an offchain multisig EOA; contract code not required.
TESTNET_PAYMENT_STOP_AUTHORITY=
TESTNET_PAYMENT_CONTRACT_CODE_HASH=
TESTNET_PAYMENT_TOKEN_CODE_HASH=
# Worker signer paths must be absolute; API may leave signer paths empty.
TESTNET_PAYMENT_CAST_PATH=
TESTNET_PAYMENT_KEYSTORE=
TESTNET_PAYMENT_PASSWORD_FILE=
TESTNET_RESERVE_ENABLED=false
TESTNET_RESERVE_MODE=debt
# Existing test deployment: aave. New ReserveVault deployments: vault.
TESTNET_RESERVE_CUSTODY=aave
TESTNET_RESERVE_MANAGER=
TESTNET_RESERVE_CONTRACT=
TESTNET_RESERVE_CODE_HASH=
TESTNET_RESERVE_OPERATOR=
TESTNET_RESERVE_POOL=
TESTNET_RESERVE_ATOKEN=
TESTNET_RESERVE_TREASURY=
TESTNET_RESERVE_KEYSTORE=
TESTNET_RESERVE_PASSWORD_FILE=

# Mera-only EIP-7702 sponsorship. Addresses/code hash come from the verified deployment.
# platform reuses PAYMENT_PROVIDER / PAYMENT_KEYSTORE / PAYMENT_PASSWORD_FILE.
# dedicated instead uses the three MERA sponsor fields below.
TESTNET_MERA_GAS_SPONSORSHIP_ENABLED=false
TESTNET_MERA_SPONSOR_MODE=platform
TESTNET_MERA_IMPLEMENTATION=
TESTNET_MERA_CODE_HASH=
TESTNET_MERA_SPONSOR_ADDRESS=
TESTNET_MERA_KEYSTORE=
TESTNET_MERA_PASSWORD_FILE=
TESTNET_MERA_DAILY_TRANSACTIONS=30
TESTNET_MERA_MAX_GAS_WEI=150000000000000000
TESTNET_MERA_DAILY_GAS_WEI=1000000000000000000

# MONAD MAINNET (143) — native Circle USDC (6 decimals) held directly in ReserveVault
# Separate DB and Redis DB. No fallback to unprefixed testnet chain settings.
# Enable settlement only after scripts/configure-mainnet.mjs verifies deployment.
MAINNET_DATABASE_URL=postgres://localhost:55432/tokenswoop_mainnet?sslmode=disable
MAINNET_REDIS_URL=redis://127.0.0.1:6389/1
MAINNET_SETTLEMENT_ENABLED=false
# Private HTTPS RPC only here; never use VITE_* or put it in source.
MAINNET_PAYMENT_RPC_URL=
# Endpoint quota shared by API, Worker, Reserve and /api/rpc; QuickNode: 40.
MAINNET_PAYMENT_RPC_RPS=40
MAINNET_PAYMENT_CONTRACT=
MAINNET_PAYMENT_TOKEN=0x754704Bc059F8C67012fEd69BC8A327a5aafb603
MAINNET_PAYMENT_PROVIDER=
MAINNET_PAYMENT_RECIPIENT=
# Fixed stop address may be an offchain multisig EOA; contract code not required.
MAINNET_PAYMENT_STOP_AUTHORITY=
MAINNET_PAYMENT_CONTRACT_CODE_HASH=
MAINNET_PAYMENT_TOKEN_CODE_HASH=
# Worker signer paths must be absolute; API may leave signer paths empty.
MAINNET_PAYMENT_CAST_PATH=
MAINNET_PAYMENT_KEYSTORE=
MAINNET_PAYMENT_PASSWORD_FILE=
MAINNET_RESERVE_ENABLED=false
MAINNET_RESERVE_MODE=debt
MAINNET_RESERVE_CUSTODY=vault
MAINNET_RESERVE_MANAGER=
MAINNET_RESERVE_CONTRACT=
MAINNET_RESERVE_CODE_HASH=
MAINNET_RESERVE_OPERATOR=
MAINNET_RESERVE_POOL=
MAINNET_RESERVE_ATOKEN=
MAINNET_RESERVE_TREASURY=
MAINNET_RESERVE_KEYSTORE=
MAINNET_RESERVE_PASSWORD_FILE=

MAINNET_MERA_GAS_SPONSORSHIP_ENABLED=false
MAINNET_MERA_SPONSOR_MODE=platform
MAINNET_MERA_IMPLEMENTATION=
MAINNET_MERA_CODE_HASH=
MAINNET_MERA_SPONSOR_ADDRESS=
MAINNET_MERA_KEYSTORE=
MAINNET_MERA_PASSWORD_FILE=
MAINNET_MERA_DAILY_TRANSACTIONS=30
MAINNET_MERA_MAX_GAS_WEI=1000000000000000000
MAINNET_MERA_DAILY_GAS_WEI=1000000000000000000

# Used only by the explicit mainnet contract deployment script.
# Deployer needs MON for gas; no USDC seed funds or rounding buffer.
MAINNET_DEPLOYER_ADDRESS=
